{
  "version": "step70.1",
  "product": "EVIRA",
  "purpose": "Route each user question to the narrowest intelligence layer before AI generation.",
  "default_layer": "seat",
  "layers": [
    {"id":"seat","label":"Seat Intelligence","grounding":["2022 Assembly baseline","selected constituency context"]},
    {"id":"booth","label":"Booth Intelligence","grounding":["Form20 booth data","candidate/party mapping"]},
    {"id":"history","label":"Election History","grounding":["2012/2017/2022 historical election data"]},
    {"id":"movement","label":"Election Movement","grounding":["2022 Assembly","2024 Lok Sabha assembly-segment data"]},
    {"id":"campaign","label":"Campaign Intelligence","grounding":["verified constituency context","booth signals","election movement"]},
    {"id":"issues","label":"Constituency Issues","grounding":["verified constituency context"]},
    {"id":"live","label":"Current Politics","grounding":["live source-attributed content"],"requires_fresh_sources":true}
  ],
  "principles": [
    "Do not mutate canonical election data.",
    "Do not invent current facts when live sources are unavailable.",
    "Prefer the narrowest relevant data layer.",
    "Pass route metadata to the AI Worker for deeper generation.",
    "Keep response language independent from UI default language."
  ]
}
