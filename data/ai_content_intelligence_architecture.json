{
  "version": "1.0",
  "name": "Top Analytica Political Intelligence — Content Intelligence Layer",
  "base": "STEP29_SELECTED_PARTY_FIRST_BOOTH_TABLE",
  "principles": [
    "Canonical election data remains the source of truth.",
    "AI never edits canonical data.",
    "New content is additive and source-attributed.",
    "Every news/issue item carries source, date, freshness, confidence and mapped entities.",
    "AC, party and candidate mappings use existing canonical identifiers.",
    "Unknown mappings remain unknown; the system must not invent them."
  ],
  "layers": [
    {
      "id": "L1",
      "name": "Canonical Data",
      "sources": [
        "2022 Assembly",
        "2012/2017 History",
        "2024 Lok Sabha Assembly Segment",
        "Form20/Booth"
      ]
    },
    {
      "id": "L2",
      "name": "Derived Intelligence",
      "sources": [
        "margin",
        "vote share",
        "turnout",
        "booth A/B/C",
        "selected-party signals"
      ]
    },
    {
      "id": "L3",
      "name": "Content Intelligence",
      "sources": [
        "user-provided datasets",
        "official sources",
        "news feeds",
        "reference sources"
      ]
    },
    {
      "id": "L4",
      "name": "Context Builder",
      "sources": [
        "AC",
        "party",
        "candidate",
        "issue",
        "date",
        "source"
      ]
    },
    {
      "id": "L5",
      "name": "AI Copilot",
      "outputs": [
        "answers",
        "summaries",
        "comparisons",
        "watch items",
        "source-backed insights"
      ]
    }
  ],
  "future_ingestion": {
    "required_fields": [
      "id",
      "title",
      "summary",
      "source",
      "source_url",
      "published_at",
      "retrieved_at",
      "content_type",
      "ac_no",
      "party_ids",
      "candidate_ids",
      "issue_tags",
      "confidence"
    ],
    "policy": "Do not merge into canonical election files. Store as separate additive content datasets."
  }
}